# 公开构建配置，不得填入访问令牌或其他秘密；留空时显示入口待开放。
VITE_WEB_APP_URL=https://photo.016imcn.love
# 正式官网 HTTPS 地址；留空时不生成 canonical。
VITE_SITE_URL=https://www.016imcn.love

# 各平台正式发布后设为 available，并填写版本、架构与 HTTPS 地址。
# 四项齐全才显示下载链接；地址可为安装包或官方商店链接。
VITE_WINDOWS_STATUS=comingSoon
VITE_WINDOWS_VERSION=
VITE_WINDOWS_ARCHITECTURE=
VITE_WINDOWS_DOWNLOAD_URL=

VITE_MACOS_STATUS=comingSoon
VITE_MACOS_VERSION=
VITE_MACOS_ARCHITECTURE=
VITE_MACOS_DOWNLOAD_URL=

VITE_ANDROID_STATUS=comingSoon
VITE_ANDROID_VERSION=
VITE_ANDROID_ARCHITECTURE=
VITE_ANDROID_DOWNLOAD_URL=

# 随官网 dist 托管已校验的安卓测试包；需先构建 frontend/apps/android。
# 此模式显示为测试版，独立于上面的正式发布配置；false 可关闭。
VITE_ANDROID_BUNDLED_DOWNLOADS=true
VITE_ANDROID_ASSET_BASE=/releases/android

VITE_IOS_STATUS=comingSoon
VITE_IOS_VERSION=
VITE_IOS_ARCHITECTURE=
VITE_IOS_DOWNLOAD_URL=
