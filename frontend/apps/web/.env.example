# 后端服务主机，仅配置协议、域名/IP 和端口；API 路径由前端代码拼接。
VITE_API_BASE_URL=http://127.0.0.1:8089
# 可选：覆盖 Vite 开发代理目标；未设置时复用 VITE_API_BASE_URL。
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8089

# 可选：安卓签名页面更新清单；实际发布地址通过环境配置管理。
# VITE_ANDROID_WEB_UPDATE_URL=https://your-web-host.example/android-updates/latest.json
# 可选：Android 壳分享作品集所使用的公开 Web 根地址，必须是 HTTPS。
# VITE_PUBLIC_WEB_BASE_URL=https://your-web-host.example/
