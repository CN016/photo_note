# PostgreSQL bootstrap administrator; use this account only for database administration and migrations.
POSTGRES_DB=photo_nini
POSTGRES_USER=photo_nini_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD

# Least-privileged account for the application at runtime.
APP_DB_USER=photo_nini_app
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
