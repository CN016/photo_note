# PostgreSQL 17 初始化账号；API 默认复用 POSTGRES_USER 连接数据库。
POSTGRES_DB=photo_nini
POSTGRES_USER=photo_nini_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD

# Redis 服务访问密码；请替换为独立随机值，Redis 仅在 Compose 内部网络开放。
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX_PASSWORD

# 如生产环境使用受限数据库账号，可设置 DB_USER/DB_PASSWORD 覆盖 POSTGRES_USER。
# DB_USER=photo_nini_app
# DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD

# 以下变量仅调整数据库或 Redis 连接；HTTP 和认证运行参数由 app_configs 配置表提供。
# DB_SSLMODE=disable
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m
# REDIS_DB=0
